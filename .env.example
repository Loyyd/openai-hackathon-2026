# No real credentials are needed for the demo.
OPENAI_API_KEY=
# Empty selects seeded in-memory storage. SQLite: sqlite:///./sentinelx.db
# PostgreSQL: postgresql+psycopg://sentinelx:sentinelx@localhost:5432/sentinelx
DATABASE_URL=
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_DATA=false
# Browser API requests always use /backend; BACKEND_URL is server-side only.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional HTML attribution for an alternative tile provider:
NEXT_PUBLIC_MAP_ATTRIBUTION=
