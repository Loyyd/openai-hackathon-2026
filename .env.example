# No real credentials are needed for the demo.
OPENAI_API_KEY=
# Empty uses sqlite:///./output/cameras.db; no demo seeds.
# PostgreSQL via Docker Compose: postgresql+psycopg://sentinelx:sentinelx@localhost:5433/sentinelx
DATABASE_URL=sqlite:///./output/cameras.db
SNAPSHOT_STORAGE_DIR=backend/uploads
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_DATA=false
# Browser API requests always use /backend; BACKEND_URL is server-side only.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional HTML attribution for an alternative tile provider:
NEXT_PUBLIC_MAP_ATTRIBUTION=

# One backend process owns the local camera worker.
CAMERA_WORKER_ENABLED=true
CAMERA_INGESTION_ENABLED=true
CAMERA_POLL_SECONDS=60
VEHICLE_WEIGHTS=yolo11m.pt
VEHICLE_DEVICE=auto
CONGESTION_REVIEW_THRESHOLD=12
